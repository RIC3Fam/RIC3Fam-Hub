<main class="profile-page">
    {{#if isPublic}}
        <span class="visibility-badge visibility-public">Public</span>
    {{else}}
        <span class="visibility-badge visibility-private">Private</span>
    {{/if}}

    <h1 class="profile-name-top">{{user.name}}</h1>

    <div class="profile-hero">
        <img
            src="{{user.profilePicture}}"
            class="profile-picture profile-picture-square"
            alt="{{user.name}}'s profile picture"
        >

        <div class="profile-short-desc-wrap">
            {{#if shortDescription}}
                <p class="profile-short-desc">{{shortDescription}}</p>
            {{/if}}
        </div>

        <p class="profile-username">@{{user.username}}</p>

        <div class="profile-link profile-link-website">
            {{#if user.link1}}
                <a href="{{user.link1}}" target="_blank" rel="noopener noreferrer">{{#if user.link1desc}}{{user.link1desc}}{{else}}Website{{/if}}</a>
            {{/if}}
        </div>

        <div class="profile-link profile-link-social">
            {{#if user.link2}}
                <a href="{{user.link2}}" target="_blank" rel="noopener noreferrer">{{#if user.link2desc}}{{user.link2desc}}{{else}}Social Media{{/if}}</a>
            {{/if}}
        </div>
    </div>

    {{#if longDescription}}
        <div class="profile-description">{{longDescription}}</div>
    {{/if}}

    {{#if hasProfileGalleryInfo}}
        <section class="profile-section profile-picture-bar">
            {{#if user.slideshowDescription}}
                <p class="picture-bar-description">{{user.slideshowDescription}}</p>
            {{/if}}
            {{#if user.statement2}}
                <p class="profile-short-desc profile-short-desc-secondary">{{user.statement2}}</p>
            {{/if}}
            {{#if user.link3}}
                <div class="profile-extra-links">
                    <a href="{{user.link3}}" target="_blank" rel="noopener noreferrer">{{#if user.link3desc}}{{user.link3desc}}{{else}}Website 3{{/if}}</a>
                    {{#if user.link4}}
                        <a href="{{user.link4}}" target="_blank" rel="noopener noreferrer">{{#if user.link4desc}}{{user.link4desc}}{{else}}Website 4{{/if}}</a>
                    {{/if}}
                </div>
            {{else}}
                {{#if user.link4}}
                    <div class="profile-extra-links">
                        <a href="{{user.link4}}" target="_blank" rel="noopener noreferrer">{{#if user.link4desc}}{{user.link4desc}}{{else}}Website 4{{/if}}</a>
                    </div>
                {{/if}}
            {{/if}}
            {{> showSlideshow}}
        </section>
    {{/if}}

    {{#if isOwner}}
        <section class="profile-section">
            {{> addToSlideshow route=user._id}}
        </section>
    {{/if}}

    {{#if user.additionalDescription}}
        <section class="profile-section">
            <div class="profile-description">{{user.additionalDescription}}</div>
        </section>
    {{/if}}

    <section class="profile-section">
        <h3>Family</h3>
        <ul>
            {{#each friends}}
                <li><a href="/users/{{this._id}}">{{this.name}}</a></li>
            {{/each}}
        </ul>
    </section>

    <section class="profile-section">
        <h3>Groups</h3>
        <ul>
            {{#each groups}}
                <li><a href="/groups/{{this._id}}">{{this.name}}</a></li>
            {{/each}}
        </ul>
    </section>

    {{#if canSeePrivateCommunications}}
        <section class="profile-section private-box">
            <h3>Private Communications – Admin only View</h3>
            <h4 class="form-label">Notes for/chat with RIC3 Fam</h4>
            {{#if user.privateDescription}}
                <div class="description-box">{{user.privateDescription}}</div>
            {{else}}
                <p class="muted">No notes yet.</p>
            {{/if}}
            {{#if user.preferredEmail}}
                <p>Email: <a href="mailto:{{user.preferredEmail}}">{{user.preferredEmail}}</a></p>
            {{/if}}
            {{#if user.preferredPhone}}
                <p>Phone: <a href="tel:{{user.preferredPhone}}">{{user.preferredPhone}}</a></p>
            {{/if}}
            {{#if user.birthday}}
                <p>Birthday: {{user.birthday}}</p>
            {{/if}}
            {{#if user.halfBirthday}}
                <p>Half Birthday: {{user.halfBirthday}}</p>
            {{/if}}
            {{#unless user.preferredEmail}}
                {{#unless user.preferredPhone}}
                    {{#unless user.birthday}}
                        {{#unless user.halfBirthday}}
                            {{#unless user.privateDescription}}
                                <p class="muted">No private contact info yet.</p>
                            {{/unless}}
                        {{/unless}}
                    {{/unless}}
                {{/unless}}
            {{/unless}}

            <div class="opt-in-readonly">
                <label class="opt-in-label">
                    <input type="checkbox" disabled {{#if user.optInCreativeRealEstate}}checked{{/if}}>
                    Opt-into Creative Real Estate &amp; Artists in Residence(s) updates
                </label>
                <label class="opt-in-label">
                    <input type="checkbox" disabled {{#if user.optInFrisbeeNotices}}checked{{/if}}>
                    Opt into RIC3 Fam Frisbee event notices
                </label>
                <label class="opt-in-label">
                    <input type="checkbox" disabled {{#if user.optInCcsnUpdates}}checked{{/if}}>
                    Opt into CCSN updates and volunteer opportunities
                </label>
            </div>
        </section>
    {{/if}}

    <section class="profile-section">
        <h3>Events</h3>
        <ul>
            {{#each games}}
                <li><a href="/events/{{this._id}}">{{this.name}}</a></li>
            {{/each}}
        </ul>
    </section>

    {{#if canSeeAdminNotes}}
        <section class="profile-section private-box admin-notes-box">
            <h3>Admin Notes</h3>
            {{#if user.adminNotes}}
                <div class="description-box">{{user.adminNotes}}</div>
            {{else}}
                <p class="muted">No admin notes yet.</p>
            {{/if}}
            <form method="POST" action="/users/{{user._id}}/admin-notes" class="admin-notes-form">
                <label class="form-label" for="adminNotes">Edit admin notes</label>
                <textarea class="form-input" id="adminNotes" name="adminNotes" rows="4">{{user.adminNotes}}</textarea>
                <button type="submit" class="form-submit-button">Save admin notes</button>
            </form>

            <form method="POST" action="/users/{{user._id}}/admin-reset-password" class="admin-password-reset-form">
                <h4 class="form-label">Reset Password</h4>
                <label class="form-label" for="adminNewPassword">New Password</label>
                <input class="form-input" type="password" id="adminNewPassword" name="adminNewPassword" autocomplete="new-password">
                <label class="form-label" for="adminConfirmPassword">Confirm New Password</label>
                <input class="form-input" type="password" id="adminConfirmPassword" name="adminConfirmPassword" autocomplete="new-password">
                <button type="submit" class="form-submit-button">Reset Password</button>
            </form>
        </section>
    {{/if}}

    {{#if isOwner}}
        {{#if requests}}
            <div id="friend-request-wrapper" class="profile-section">
                <h3>Incoming Family Requests</h3>
                {{#each requests}}
                    <div id="friend-request">
                        <a class="request-sender">{{this.name}}</a>
                        <form action="/users/{{../user._id}}/friends/acceptRequest" method="POST" class="button-wrapper">
                            <input type="hidden" name="friendUserId" value="{{this._id}}">
                            <button type="submit" class="accept-button">Accept</button>
                        </form>
                        <form action="/users/{{../user._id}}/friends/rejectRequest" method="POST" class="button-wrapper">
                            <input type="hidden" name="friendUserId" value="{{this._id}}">
                            <button type="submit" class="reject-button">Reject</button>
                        </form>
                    </div>
                {{/each}}
            </div>
        {{/if}}
        <form action="/users/edit/{{user._id}}" method="GET">
            <button type="submit" class="edit-button">Edit Profile</button>
        </form>
        <form action="/users/delete/{{user._id}}" method="POST" onsubmit="return confirmDelete('user');">
            <button type="submit" class="delete-button">Delete Profile</button>
        </form>
    {{else if currentUser}}
        {{#if notFriend}}
        <form action="/users/{{user._id}}/friends/sendRequest" method="POST">
            <button type="submit" class="add-friend">Add Family</button>
        </form>
        {{/if}}
    {{else}}
        <p>To add this user as family, please <a href="/login">login</a>.</p>
    {{/if}}
</main>
