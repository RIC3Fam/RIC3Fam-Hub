<main class="profile-page">
    {{#if isPublic}}
        <span class="visibility-badge visibility-public">Public</span>
    {{else}}
        <span class="visibility-badge visibility-private">Private</span>
    {{/if}}

    <h1 class="profile-name-top">{{user.name}}</h1>

    <div class="profile-layout">
        <div class="profile-left">
            <img src="{{user.profilePicture}}" class="profile-picture profile-picture-square" alt="{{user.name}}'s profile picture">
            <p class="profile-username">@{{user.username}}</p>
            {{#if user.link1}}
                <p class="profile-link profile-link-col">
                    <a href="{{user.link1}}" target="_blank" rel="noopener noreferrer">{{#if user.link1desc}}{{user.link1desc}}{{else}}Website{{/if}}</a>
                </p>
            {{/if}}
        </div>
        <div class="profile-right">
            {{#if shortDescription}}
                <p class="profile-statement profile-short-desc">{{shortDescription}}</p>
            {{/if}}
            {{#if user.link2}}
                <p class="profile-link profile-link-col">
                    <a href="{{user.link2}}" target="_blank" rel="noopener noreferrer">{{#if user.link2desc}}{{user.link2desc}}{{else}}Social Media{{/if}}</a>
                </p>
            {{/if}}
        </div>
    </div>

    {{#if slideshowImages.length}}
        <section class="profile-section">
            {{#if user.slideshowDescription}}
                <p class="picture-bar-description">{{user.slideshowDescription}}</p>
            {{/if}}
            {{> showSlideshow}}
        </section>
    {{else}}
        {{#if isOwner}}
            <section class="profile-section">
                {{> addToSlideshow route=user._id}}
            </section>
        {{/if}}
    {{/if}}

    {{#if isOwner}}
        {{#if slideshowImages.length}}
            <section class="profile-section">
                {{> addToSlideshow route=user._id}}
            </section>
        {{/if}}
    {{/if}}

    {{#if user.additionalDescription}}
        <section class="profile-section">
            <div class="description-box">{{user.additionalDescription}}</div>
        </section>
    {{/if}}

    <section class="profile-section">
        <h3>Family</h3>
        <ul>
            {{#each friends}}
                <li><a href="/users/{{this._id}}">{{this.name}}</a></li>
            {{/each}}
        </ul>
    </section>

    <section class="profile-section">
        <h3>Groups</h3>
        <ul>
            {{#each groups}}
                <li><a href="/groups/{{this._id}}">{{this.name}}</a></li>
            {{/each}}
        </ul>
    </section>

    {{#if canSeePrivateCommunications}}
        <section class="profile-section private-box">
            <h3>Private Communications – Admin only View</h3>
            {{#if user.privateDescription}}
                <div class="description-box">{{user.privateDescription}}</div>
            {{/if}}
            {{#if user.preferredEmail}}
                <p>Email: <a href="mailto:{{user.preferredEmail}}">{{user.preferredEmail}}</a></p>
            {{/if}}
            {{#if user.preferredPhone}}
                <p>Phone: <a href="tel:{{user.preferredPhone}}">{{user.preferredPhone}}</a></p>
            {{/if}}
            {{#unless user.privateDescription}}
                {{#unless user.preferredEmail}}
                    {{#unless user.preferredPhone}}
                        <p class="muted">No private communications yet.</p>
                    {{/unless}}
                {{/unless}}
            {{/unless}}
        </section>
    {{/if}}

    <section class="profile-section">
        <h3>Events</h3>
        <ul>
            {{#each games}}
                <li><a href="/events/{{this._id}}">{{this.name}}</a></li>
            {{/each}}
        </ul>
    </section>

    {{#if canSeeConnections}}
        <div id="skill-wrapper" class="profile-section private-box">
            <h3>RIC3 Fam Connections – Admin only view</h3>
            <ul>
                {{#each user.skills}}
                    {{#ifEquals this.type "checkbox"}}
                        {{#if this.value}}
                            <li>{{this.desc}}: &#x2713;</li>
                        {{/if}}
                    {{/ifEquals}}
                    {{#ifEquals this.type "text"}}
                        {{#elseEquals this.value ''}}
                            <li>{{this.desc}}: {{this.value}}</li>
                        {{/elseEquals}}
                    {{/ifEquals}}
                    {{#ifEquals this.type "number"}}
                        {{#elseEquals this.value 0}}
                            <li>{{this.desc}}: {{this.value}}</li>
                        {{/elseEquals}}
                    {{/ifEquals}}
                {{/each}}
            </ul>
            {{#if user.optInCreativeRealEstate}}
                <p>✓ Opted into Creative Real Estate &amp; Artists in Residence(s) updates</p>
            {{/if}}
            {{#if user.optInFrisbeeNotices}}
                <p>✓ Opted into RIC3 Fam Frisbee event notices</p>
            {{/if}}
            {{#if user.optInCcsnUpdates}}
                <p>✓ Opted into CCSN updates and volunteer opportunities</p>
            {{/if}}
        </div>
    {{/if}}

    {{#if canSeeAdminNotes}}
        <section class="profile-section private-box admin-notes-box">
            <h3>Admin Notes</h3>
            {{#if user.adminNotes}}
                <div class="description-box">{{user.adminNotes}}</div>
            {{else}}
                <p class="muted">No admin notes yet.</p>
            {{/if}}
            <form method="POST" action="/users/{{user._id}}/admin-notes" class="admin-notes-form">
                <label class="form-label" for="adminNotes">Edit admin notes</label>
                <textarea class="form-input" id="adminNotes" name="adminNotes" rows="4">{{user.adminNotes}}</textarea>
                <button type="submit" class="form-submit-button">Save admin notes</button>
            </form>
        </section>
    {{/if}}

    {{#if isOwner}}
        {{#if requests}}
            <div id="friend-request-wrapper" class="profile-section">
                <h3>Incoming Family Requests</h3>
                {{#each requests}}
                    <div id="friend-request">
                        <a class="request-sender">{{this.name}}</a>
                        <form action="/users/{{../user._id}}/friends/acceptRequest" method="POST" class="button-wrapper">
                            <input type="hidden" name="friendUserId" value="{{this._id}}">
                            <button type="submit" class="accept-button">Accept</button>
                        </form>
                        <form action="/users/{{../user._id}}/friends/rejectRequest" method="POST" class="button-wrapper">
                            <input type="hidden" name="friendUserId" value="{{this._id}}">
                            <button type="submit" class="reject-button">Reject</button>
                        </form>
                    </div>
                {{/each}}
            </div>
        {{/if}}
        <form action="/users/edit/{{user._id}}" method="GET">
            <button type="submit" class="edit-button">Edit Profile</button>
        </form>
        <form action="/users/delete/{{user._id}}" method="POST" onsubmit="return confirmDelete('user');">
            <button type="submit" class="delete-button">Delete Profile</button>
        </form>
    {{else if currentUser}}
        {{#if notFriend}}
        <form action="/users/{{user._id}}/friends/sendRequest" method="POST">
            <button type="submit" class="add-friend">Add Family</button>
        </form>
        {{/if}}
    {{else}}
        <p>To add this user as family, please <a href="/login">login</a>.</p>
    {{/if}}
</main>
