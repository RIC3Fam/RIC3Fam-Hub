<main>
    {{#if isPublic}}
        <span class="visibility-badge visibility-public">Public</span>
    {{else}}
        <span class="visibility-badge visibility-private">Private</span>
    {{/if}}

    <div class="profile-layout">
        <div class="profile-left">
            <h1 class="profile-name">{{user.name}}</h1>
            <img src="{{user.profilePicture}}" class="profile-picture" alt="{{user.name}}'s profile picture">
            <p class="profile-username">@{{user.username}}</p>
        </div>
        <div class="profile-right">
            {{#if user.statement}}
                <h3>Personal / Artist Statement</h3>
                <p class="profile-statement">{{user.statement}}</p>
            {{/if}}
            {{#if user.link1}}
                <p class="profile-link">
                    <span class="profile-link-label">Website:</span>
                    <a href="{{user.link1}}" target="_blank" rel="noopener noreferrer">{{#if user.link1desc}}{{user.link1desc}}{{else}}{{user.link1}}{{/if}}</a>
                </p>
            {{/if}}
            {{#if user.link2}}
                <p class="profile-link">
                    <span class="profile-link-label">Social:</span>
                    <a href="{{user.link2}}" target="_blank" rel="noopener noreferrer">{{#if user.link2desc}}{{user.link2desc}}{{else}}{{user.link2}}{{/if}}</a>
                </p>
            {{/if}}
            {{#if user.description}}
                <h3>Description</h3>
                <div class="description-box">{{user.description}}</div>
            {{/if}}
        </div>
    </div>

    {{#if user.slideshowImages.length}}
        <section class="profile-section">
            <h3>Picture Bar</h3>
            {{#if user.slideshowDescription}}
                <p class="picture-bar-description">{{user.slideshowDescription}}</p>
            {{/if}}
            {{> showSlideshow}}
        </section>
    {{/if}}

    {{#if user.additionalDescription}}
        <section class="profile-section">
            <h3>Additional Description</h3>
            <div class="description-box">{{user.additionalDescription}}</div>
        </section>
    {{/if}}

    <section class="profile-section">
        <h3>Family</h3>
        <ul>
            {{#each friends}}
                <li><a href="/users/{{this._id}}">{{this.name}}</a></li>
            {{/each}}
        </ul>
    </section>

    <section class="profile-section">
        <h3>Groups</h3>
        <ul>
            {{#each groups}}
                <li><a href="/groups/{{this._id}}">{{this.name}}</a></li>
            {{/each}}
        </ul>
    </section>

    {{#if canSeePrivateBox}}
        <section class="profile-section private-box">
            <h3>Private Description</h3>
            {{#if user.privateDescription}}
                <div class="description-box">{{user.privateDescription}}</div>
            {{else}}
                <p class="muted">No private description yet.</p>
            {{/if}}
        </section>
    {{/if}}

    <section class="profile-section">
        <h3>Events</h3>
        <ul>
            {{#each games}}
                <li><a href="/events/{{this._id}}">{{this.name}}</a></li>
            {{/each}}
        </ul>
    </section>

    <div id="skill-wrapper" class="profile-section">
        <h3>Skills</h3>
        <ul>
            {{#each user.skills}}
                {{#ifEquals this.type "checkbox"}}
                    {{#if this.value}}
                        <li>{{this.desc}}: &#x2713;</li>
                    {{/if}}
                {{/ifEquals}}
                {{#ifEquals this.type "text"}}
                    {{#elseEquals this.value ''}}
                        <li>{{this.desc}}: {{this.value}}</li>
                    {{/elseEquals}}
                {{/ifEquals}}
                {{#ifEquals this.type "number"}}
                    {{#elseEquals this.value 0}}
                        <li>{{this.desc}}: {{this.value}}</li>
                    {{/elseEquals}}
                {{/ifEquals}}
            {{/each}}
        </ul>
    </div>

    {{#if isOwner}}
        {{#if requests}}
            <div id="friend-request-wrapper" class="profile-section">
                <h3>Incoming Family Requests</h3>
                {{#each requests}}
                    <div id="friend-request">
                        <a class="request-sender">{{this.name}}</a>
                        <form action="/users/{{../user._id}}/friends/acceptRequest" method="POST" class="button-wrapper">
                            <input type="hidden" name="friendUserId" value="{{this._id}}">
                            <button type="submit" class="accept-button">Accept</button>
                        </form>
                        <form action="/users/{{../user._id}}/friends/rejectRequest" method="POST" class="button-wrapper">
                            <input type="hidden" name="friendUserId" value="{{this._id}}">
                            <button type="submit" class="reject-button">Reject</button>
                        </form>
                    </div>
                {{/each}}
            </div>
        {{/if}}
        <form action="/users/edit/{{user._id}}" method="GET">
            <button type="submit" class="edit-button">Edit Profile</button>
        </form>
        <form action="/users/delete/{{user._id}}" method="POST" onsubmit="return confirmDelete('user');">
            <button type="submit" class="delete-button">Delete Profile</button>
        </form>
    {{else if currentUser}}
        {{#if notFriend}}
        <form action="/users/{{user._id}}/friends/sendRequest" method="POST">
            <button type="submit" class="add-friend">Add Family</button>
        </form>
        {{/if}}
    {{else}}
        <p>To add this user as family, please <a href="/login">login</a>.</p>
    {{/if}}
</main>
