<main>
    <div class="form-wrapper">
        <form action="/users/edit/{{currentUser._id}}" method="POST" id="create-user-form" class="create-form">
            <h3>Edit user</h3>
            <label class="form-label" for="name">Name:</label>
                <input class="form-input" type="text" id="name" name="name" value="{{currentUser.name}}">
                <br>
            <label class="form-label" for="username">Username:</label>
                <input class="form-input" type="text" id="username" name="username" value="{{currentUser.username}}">
                <br>
            <label class="form-label" for="email">Email:</label>
                <input class="form-input" type="email" id="email" name="email" value="{{currentUser.emailAddress}}">
                <br>
            <label class="form-label" for="statement">Short Description:</label>
                <textarea class="form-input" id="statement" name="statement">{{currentUser.statement}}</textarea>
                <br>
            <label class="form-label" for="description">Description:</label>
                <textarea class="form-input" id="description" name="description">{{currentUser.description}}</textarea>
                <br>
            <label class="form-label" for="link1">Website URL:</label>
                <input class="form-input" type="url" id="link1" name="link1" value="{{currentUser.link1}}">
                <br>
            <label class="form-label" for="link1desc">Website label:</label>
                <input class="form-input" id="link1desc" name="link1desc" value="{{currentUser.link1desc}}">
                <br>
            <label class="form-label" for="link2">Social media URL:</label>
                <input class="form-input" type="url" id="link2" name="link2" value="{{currentUser.link2}}">
                <br>
            <label class="form-label" for="link2desc">Social label:</label>
                <input class="form-input" id="link2desc" name="link2desc" value="{{currentUser.link2desc}}">
                <br>
            <label class="form-label" for="additionalDescription">Additional description:</label>
                <textarea class="form-input" id="additionalDescription" name="additionalDescription">{{currentUser.additionalDescription}}</textarea>
                <br>
            <label class="form-label" for="slideshowDescription">Picture gallery note:</label>
                <textarea class="form-input" id="slideshowDescription" name="slideshowDescription">{{currentUser.slideshowDescription}}</textarea>
                <br>
            <label class="form-label" for="visibility">Visibility:</label>
                <select class="form-input" id="visibility" name="visibility">
                    <option value="public" {{#elseEquals currentUser.visibility "private"}}selected{{/elseEquals}}>Public</option>
                    <option value="private" {{#ifEquals currentUser.visibility "private"}}selected{{/ifEquals}}>Private</option>
                </select>
                <br>

            <h4>Private Communications</h4>
            <label class="form-label" for="privateDescription">Notes for/chat with RIC3 Fam:</label>
                <textarea class="form-input" id="privateDescription" name="privateDescription">{{currentUser.privateDescription}}</textarea>
                <br>
            <label class="form-label" for="preferredEmail">Preferred Communication (private) – Email:</label>
                <input class="form-input" type="email" id="preferredEmail" name="preferredEmail" value="{{currentUser.preferredEmail}}" placeholder="name@example.com" autocomplete="email">
                <br>
            <label class="form-label" for="preferredPhone">Preferred Communication (private) – Phone:</label>
                <input class="form-input" type="tel" id="preferredPhone" name="preferredPhone" value="{{currentUser.preferredPhone}}" placeholder="(555) 555-5555" autocomplete="tel">
                <br>

            <h4>Updates &amp; notices</h4>
            <label class="form-label opt-in-label" for="optInCreativeRealEstate">
                <input type="checkbox" id="optInCreativeRealEstate" name="optInCreativeRealEstate" value="true" {{#if currentUser.optInCreativeRealEstate}}checked{{/if}}>
                Opt-into Creative Real Estate &amp; Artists in Residence(s) updates
            </label>
            <br>
            <label class="form-label opt-in-label" for="optInFrisbeeNotices">
                <input type="checkbox" id="optInFrisbeeNotices" name="optInFrisbeeNotices" value="true" {{#if currentUser.optInFrisbeeNotices}}checked{{/if}}>
                Opt into RIC3 Fam Frisbee event notices
            </label>
            <br>
            <label class="form-label opt-in-label" for="optInCcsnUpdates">
                <input type="checkbox" id="optInCcsnUpdates" name="optInCcsnUpdates" value="true" {{#if currentUser.optInCcsnUpdates}}checked{{/if}}>
                Opt into CCSN updates and volunteer opportunities
            </label>
            <br>

            <button type="button" class="form-submit-button" onclick="window.history.back();">Cancel</button>
            <button type="submit" class="form-submit-button">Submit</button>
        </form>
    </div>

    {{> updatePfp}}
    {{> addToSlideshow route=currentUser._id}}

    <p id="error-label" hidden></p>
    <p id="message-label" hidden></p>

    <script src="/public/js/pictures.js"></script>
</main>
