<main>
    <div class="form-wrapper home-edit-wrapper">
        <h3>Edit Home Page</h3>
        <p class="muted">
            Upload the billboard video and towel images.
            Set custom links for the towels, lower door, lower window, and Artists in Residence(s) button.
            Video autoplays muted on Home; visitors can unmute or double-click for fullscreen. No separate poster image.
        </p>

        <form method="POST" action="/edit-home" id="edit-home-form" class="create-form">
            <input type="hidden" name="buildingImageUrl" id="buildingImageUrl" value="{{home.buildingImageUrl}}">

            <h4>Billboard video</h4>
            <label class="form-label" for="billboardVideoUrl">Video URL (mp4) — or upload below</label>
            <input class="form-input" type="url" id="billboardVideoUrl" name="billboardVideoUrl" value="{{home.billboardVideoUrl}}" placeholder="https://.../video.mp4">
            <br>
            <div class="home-hotspot-coords">
                <label>Top % <input class="form-input" type="number" min="0" max="100" step="0.1" name="billboardTop" value="{{home.billboard.top}}"></label>
                <label>Left % <input class="form-input" type="number" min="0" max="100" step="0.1" name="billboardLeft" value="{{home.billboard.left}}"></label>
                <label>Width % <input class="form-input" type="number" min="1" max="100" step="0.1" name="billboardWidth" value="{{home.billboard.width}}"></label>
                <label>Height % <input class="form-input" type="number" min="1" max="100" step="0.1" name="billboardHeight" value="{{home.billboard.height}}"></label>
            </div>

            <h4>Towels (uploadable pictures)</h4>
            <fieldset class="home-hotspot-edit">
                <legend>Towel 1</legend>
                <input type="hidden" name="towel1ImageUrl" value="{{home.towel1.imageUrl}}">
                <label class="form-label home-hotspot-link-label">Left Towel 1 Link URL
                    <input class="form-input" type="url" name="towel1LinkUrl" value="{{home.towel1.linkUrl}}" placeholder="https://">
                </label>
                <div class="home-hotspot-coords">
                    <label>Top % <input class="form-input" type="number" min="0" max="100" step="0.1" name="towel1Top" value="{{home.towel1.top}}"></label>
                    <label>Left % <input class="form-input" type="number" min="0" max="100" step="0.1" name="towel1Left" value="{{home.towel1.left}}"></label>
                    <label>Width % <input class="form-input" type="number" min="1" max="100" step="0.1" name="towel1Width" value="{{home.towel1.width}}"></label>
                    <label>Height % <input class="form-input" type="number" min="1" max="100" step="0.1" name="towel1Height" value="{{home.towel1.height}}"></label>
                </div>
            </fieldset>
            <fieldset class="home-hotspot-edit">
                <legend>Towel 2</legend>
                <input type="hidden" name="towel2ImageUrl" value="{{home.towel2.imageUrl}}">
                <label class="form-label home-hotspot-link-label">Right Towel 2 Link URL
                    <input class="form-input" type="url" name="towel2LinkUrl" value="{{home.towel2.linkUrl}}" placeholder="https://">
                </label>
                <div class="home-hotspot-coords">
                    <label>Top % <input class="form-input" type="number" min="0" max="100" step="0.1" name="towel2Top" value="{{home.towel2.top}}"></label>
                    <label>Left % <input class="form-input" type="number" min="0" max="100" step="0.1" name="towel2Left" value="{{home.towel2.left}}"></label>
                    <label>Width % <input class="form-input" type="number" min="1" max="100" step="0.1" name="towel2Width" value="{{home.towel2.width}}"></label>
                    <label>Height % <input class="form-input" type="number" min="1" max="100" step="0.1" name="towel2Height" value="{{home.towel2.height}}"></label>
                </div>
            </fieldset>

            <h4>Artists in Residence(s) button</h4>
            <label class="form-label">Awning / upper door button URL
                <input class="form-input" type="url" name="artistsResidenceLinkUrl" value="{{home.artistsResidenceLinkUrl}}" placeholder="https://">
            </label>

            <h4>Lower door / window links</h4>
            <label class="form-label">Lower Left Door "CCSN" Link URL
                <input class="form-input" type="url" name="lowerCcsnLinkUrl" value="{{home.lowerCcsnLinkUrl}}" placeholder="https://">
            </label>
            <label class="form-label">Lower Right Window "RIC3 Fam Frisbee" Link URL
                <input class="form-input" type="url" name="lowerFrisbeeLinkUrl" value="{{home.lowerFrisbeeLinkUrl}}" placeholder="https://">
            </label>

            <h4>Top navigation links</h4>
            <p class="muted">Set optional destination links for the three grey navigation buttons above the towels.</p>
            {{#each home.hotspots}}
                <fieldset class="home-hotspot-edit">
                    <legend>
                        {{#ifEquals @index 0}}Stage & List With Us{{/ifEquals}}
                        {{#ifEquals @index 1}}Find your dream home{{/ifEquals}}
                        {{#ifEquals @index 2}}Get a home loan{{/ifEquals}}
                    </legend>
                    <input type="hidden" name="hotspots[{{@index}}][id]" value="{{this.id}}">
                    <input type="hidden" name="hotspots[{{@index}}][label]" value="{{this.label}}">
                    <label class="form-label">
                        {{#ifEquals @index 0}}Stage & List With Us Link URL{{/ifEquals}}
                        {{#ifEquals @index 1}}Find your dream home Link URL{{/ifEquals}}
                        {{#ifEquals @index 2}}Get a home loan Link URL{{/ifEquals}}
                        <input class="form-input" type="url" name="hotspots[{{@index}}][url]" value="{{this.url}}" placeholder="https://">
                    </label>
                    <div class="home-hotspot-coords">
                        <label>Top % <input class="form-input" type="number" min="0" max="100" step="0.1" name="hotspots[{{@index}}][top]" value="{{this.top}}"></label>
                        <label>Left % <input class="form-input" type="number" min="0" max="100" step="0.1" name="hotspots[{{@index}}][left]" value="{{this.left}}"></label>
                        <label>Width % <input class="form-input" type="number" min="1" max="100" step="0.1" name="hotspots[{{@index}}][width]" value="{{this.width}}"></label>
                        <label>Height % <input class="form-input" type="number" min="1" max="100" step="0.1" name="hotspots[{{@index}}][height]" value="{{this.height}}"></label>
                    </div>
                </fieldset>
            {{/each}}

            <button type="submit" class="form-submit-button">Save home settings</button>
            <a href="/">Cancel</a>
        </form>

        <hr class="my-5">

        <h4>Upload billboard video (MP4)</h4>
        <form id="home-video-form" class="create-form">
            <input type="file" id="home-video-upload" accept="video/mp4">
            <button type="submit" class="form-submit-button">Upload video</button>
        </form>

        <h4>Upload towel 1 image (JPEG)</h4>
        {{#if home.towel1.imageUrl}}
            <p class="muted">Current: <img src="{{home.towel1.imageUrl}}" alt="Towel 1" class="home-edit-thumb"></p>
        {{/if}}
        <form id="home-towel1-form" class="create-form">
            <input type="file" id="home-towel1-upload" accept="image/jpeg">
            <button type="submit" class="form-submit-button">Upload towel 1</button>
        </form>

        <h4>Upload towel 2 image (JPEG)</h4>
        {{#if home.towel2.imageUrl}}
            <p class="muted">Current: <img src="{{home.towel2.imageUrl}}" alt="Towel 2" class="home-edit-thumb"></p>
        {{/if}}
        <form id="home-towel2-form" class="create-form">
            <input type="file" id="home-towel2-upload" accept="image/jpeg">
            <button type="submit" class="form-submit-button">Upload towel 2</button>
        </form>

        <p id="error-label" hidden></p>
        <p id="message-label" hidden></p>
    </div>
    <script src="/public/js/homeEdit.js"></script>
</main>
