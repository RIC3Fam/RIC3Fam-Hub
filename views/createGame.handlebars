
<main>
    <div class="form-wrapper">
        <form action="/events" method="POST" id="create-game-form" class="create-form">
            <h3>Create Event</h3>
            <label class="form-label" for="game-name">Event Name:</label>
                <input class="form-input" type="text" id="game-name" name="gameName" required>
                <br>
            <label class="form-label" for="street-address">Street Address:</label>
                <input class="form-input" type="text" id="street-address" name="streetAddress" required>
                <br>
            <label class="form-label" for="city">City:</label>
                <input class="form-input" type="text" id="city" name="city" required>
                <br>
            <label class="form-label" for="state">State:</label>
                <select class="form-input" id="state" name="state" required>
                    <option value="" disabled selected>Select your state</option>
                {{#each states}}
                     <option value="{{this}}">{{this}}</option>
                {{/each}}
                </select>
                <br>
            <label class="form-label" for="zip">Zipcode:</label>
                <input class="form-input" type="text" id="zip" name="zip" required>
                <br>
            <label class="form-label" for="description">Description:</label>
                <textarea class="form-input" id="description" name="gameDescription"></textarea>
                <br>
            <label class="form-label" for="date">Date:</label>
                <input class="form-input" type="date" id="date" name="date" required>
                <br>
            <label class="form-label" for="start-time">Start Time:</label>
                <input class="form-input" type="time" id="start-time" name="startTime" required>
                <br>
            <label class="form-label" for="end-time">End Time:</label>
                <input class="form-input" type="time" id="end-time" name="endTime" required>
                <br>
            <label class="form-label" for="max-players">Max attendees:</label>
                <input class="form-input" type="text" id="max-players" name="maxPlayers">
                <br>
            <label class="form-label" for="group">Group 1:</label>
                <select class="form-input" id="group" name="group">
                    <option value="N/A" selected>N/A</option>
                       {{#if groups.length}}
                            {{#each groups}}
                                <option value="{{this._id}}">{{this.groupName}}</option>
                            {{/each}}
                        {{/if}}
                </select>
                <br>
            <label class="form-label" for="group2">Group 2:</label>
                <select class="form-input" id="group2" name="group2">
                    <option value="N/A" selected>N/A</option>
                       {{#if groups.length}}
                            {{#each groups}}
                                <option value="{{this._id}}">{{this.groupName}}</option>
                            {{/each}}
                        {{/if}}
                </select>
                <br>
            <label class="form-label" for="group3">Group 3:</label>
                <select class="form-input" id="group3" name="group3">
                    <option value="N/A" selected>N/A</option>
                       {{#if groups.length}}
                            {{#each groups}}
                                <option value="{{this._id}}">{{this.groupName}}</option>
                            {{/each}}
                        {{/if}}
                </select>
                <br>
            <label class="form-label" for="link">Link:</label>
                <input class="form-input" type="url" id="link" name="link">
                <br>
            <label class="form-label" for="linkdesc">Link Description:</label>
                <input class="form-input" type="text" id="linkdesc" name="linkdesc">
                <br>
            <label class="form-label" for="link2">Link 2:</label>
                <input class="form-input" type="url" id="link2" name="link2">
                <br>
            <label class="form-label" for="link2desc">Link 2 Description:</label>
                <input class="form-input" type="text" id="link2desc" name="link2desc">
                <br>
            <label class="form-label" for="visibility">Visibility:</label>
                <select class="form-input" id="visibility" name="visibility">
                    <option value="public" selected>Public</option>
                    <option value="private">Private</option>
                </select>
                <br>
            <label class="form-label" for="privateDescription">Private Description:</label>
                <textarea class="form-input" id="privateDescription" name="privateDescription"></textarea>
                <br>
            <button type="submit" id="game-submit-button" class="form-submit-button">Submit</button>
            
        </form>
    </div>
        <a id="error-label" hidden>test</a> <br>
        <a id="message-label" hidden>test2</a> <br>
    <script src='/public/js/gameValidation.js'></script>
</main>
