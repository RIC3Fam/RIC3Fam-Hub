<main>
    <div class="form-wrapper">
        <form action="/groups" method="POST" id="create-group-form" class="create-form">
            <h3>Create group</h3>
            <label class="form-label" for="group-name">Group Name:</label>
                <input class="form-input" type="text" id="group-name" name="groupName">
                <br>
           <label class="form-label" for="description">Short Description</label>
        <textarea class="form-input" id="description" name="groupDescription"></textarea>
        <br>

        <label class="form-label" for="link1">Website URL:</label>
        <input class="form-input" type="url" id="link1" name="link1" placeholder="https://">
        <br>
        <label class="form-label" for="link1desc">Website label:</label>
        <input class="form-input" type="text" id="link1desc" name="link1desc" placeholder="e.g., Website">
        <br>
        <label class="form-label" for="link2">Social media URL:</label>
        <input class="form-input" type="url" id="link2" name="link2" placeholder="https://">
        <br>
        <label class="form-label" for="link2desc">Social label:</label>
        <input class="form-input" type="text" id="link2desc" name="link2desc" placeholder="e.g., Social Media">
        <br>

        <h4>Project Framers</h4>
        <p class="muted">Title is free text. Person must be an existing profile — type to search, then select.</p>
        <div id="group-framers-editor"></div>
        <button type="button" id="add-framer-row" class="form-submit-button">Add project framer</button>
        <br>

        <label class="form-label" for="uppercaseTitle">All Caps Section Title:</label>
        <input class="form-input" type="text" id="uppercaseTitle" name="uppercaseTitle" placeholder="e.g., Gold Tier Members">
        <br>

        <label class="form-label" for="lowercaseTitle">Lowercase Section Title:</label>
        <input class="form-input" type="text" id="lowercaseTitle" name="lowercaseTitle" placeholder="e.g., Standard Members">
        <br>

        <label class="form-label" for="numericTitle">Numbered Section Title:</label>
        <input class="form-input" type="text" id="numericTitle" name="numericTitle" placeholder="e.g., Digit Accounts">
        <br>

        <label class="form-label" for="visibility">Visibility:</label>
        <select class="form-input" id="visibility" name="visibility">
            <option value="public" selected>Public</option>
            <option value="private">Private</option>
        </select>
        <br>

        <label class="form-label" for="privateDescription">Private Description:</label>
        <textarea class="form-input" id="privateDescription" name="privateDescription"></textarea>
        <br>

        <button type="submit" id="group-submit-button" class="form-submit-button">Create</button>
            
        </form>
    </div>
    <p id="message-label" hidden></p>
    <p id="error-label" hidden></p>
    <script src='/public/js/groupValidation.js'></script>
    <script src="/public/js/eventLeaders.js"></script>
</main>
