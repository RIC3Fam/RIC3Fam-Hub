<main id="index-main" class="home-facade-page">
    <section class="facade-scene" aria-label="RIC3 Fam building facade">
        <div class="facade-shell">
            <section class="facade-billboard" aria-label="Featured video billboard">
                <div class="facade-billboard-screen">
                    {{#if home.billboardVideoUrl}}
                        <video
                            id="home-billboard-video"
                            class="home-billboard-video"
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="metadata"
                            poster="/public/images/home/billboard-poster.svg"
                        >
                            <source src="{{home.billboardVideoUrl}}" type="video/mp4">
                        </video>
                        <div class="facade-video-controls" role="group" aria-label="Video controls">
                            <button type="button" id="home-billboard-play" class="facade-video-btn" aria-label="Pause video" title="Pause">Pause</button>
                            <button type="button" id="home-billboard-unmute" class="facade-video-btn" aria-label="Unmute video" title="Unmute">Unmute</button>
                        </div>
                    {{else}}
                        <div class="facade-video-poster" role="img" aria-label="Billboard video poster"></div>
                    {{/if}}
                </div>
                <div class="facade-billboard-lip" aria-hidden="true"></div>
                <div class="facade-billboard-pole" aria-hidden="true"></div>
            </section>

            <section class="facade-building" aria-label="Building facade">
                <nav class="facade-nav" aria-label="Facade links">
                    {{#each home.hotspots}}
                        {{#if this.url}}
                            <a href="{{this.url}}" target="_blank" rel="noopener noreferrer">
                                {{#ifEquals @index 0}}Stage & List With Us{{/ifEquals}}
                                {{#ifEquals @index 1}}Find your dream home{{/ifEquals}}
                                {{#ifEquals @index 2}}Get a home loan{{/ifEquals}}
                            </a>
                        {{else}}
                            <a href="/search">
                                {{#ifEquals @index 0}}Stage & List With Us{{/ifEquals}}
                                {{#ifEquals @index 1}}Find your dream home{{/ifEquals}}
                                {{#ifEquals @index 2}}Get a home loan{{/ifEquals}}
                            </a>
                        {{/if}}
                    {{/each}}
                </nav>

                <section class="facade-brick-zone" aria-label="Featured logo panels">
                    <a class="facade-top-panel facade-logo-panel" href="/events">
                        {{#if home.towel1.imageUrl}}
                            <img
                                src="{{home.towel1.imageUrl}}"
                                alt="Featured residence logo"
                                loading="lazy"
                                onerror="this.onerror=null;this.src='/public/images/home/community-logo.svg';"
                            >
                        {{else}}
                            <img src="/public/images/home/community-logo.svg" alt="Creative Community Service Network logo" loading="lazy">
                        {{/if}}
                    </a>
                    <a class="facade-top-panel facade-logo-panel" href="/search">
                        {{#if home.towel2.imageUrl}}
                            <img
                                src="{{home.towel2.imageUrl}}"
                                alt="Featured mortgage broker logo"
                                loading="lazy"
                                onerror="this.onerror=null;this.src='/public/images/home/frisbee-logo.svg';"
                            >
                        {{else}}
                            <img src="/public/images/home/frisbee-logo.svg" alt="RIC3 Fam Frisbee logo" loading="lazy">
                        {{/if}}
                    </a>
                </section>

                <section class="facade-residence-sign" aria-label="Artists in residence">
                    <h1>artists in<br>residence(s)</h1>
                </section>

                <section class="facade-balcony-zone" aria-label="Balcony level">
                    <a class="facade-upper-door" href="{{defaultUrl home.artistsResidenceLinkUrl "/events"}}">
                        <img src="/public/images/home/air-floor-plan.png" alt="Artists in Residence(s) floor plan logo" loading="lazy">
                    </a>

                    <div class="facade-balcony">
                        <a class="facade-banner facade-banner-left" href="{{defaultUrl home.towel1.linkUrl "/events"}}" aria-label="I love New York towel">
                            <img src="/public/images/home/ny-towel.png" alt="I love New York towel logo" loading="lazy">
                        </a>
                        <div class="facade-rail" aria-hidden="true"></div>
                        <a class="facade-banner facade-banner-right" href="{{defaultUrl home.towel2.linkUrl "/events"}}" aria-label="LOVE Michigan towel">
                            <img src="/public/images/home/mi-towel.png" alt="LOVE Michigan towel logo" loading="lazy">
                        </a>
                    </div>
                </section>

                <section class="facade-storefront" aria-label="Storefront level">
                    <img
                        class="facade-family-wall"
                        src="/public/images/home/we-are-family.png"
                        alt="We are a family"
                        loading="lazy"
                    >
                    <article class="facade-store facade-store-door">
                        <div class="facade-awning facade-awning-small" aria-hidden="true"></div>
                        <a class="facade-door" href="{{defaultUrl home.lowerCcsnLinkUrl "https://www.ccservicenetwork.org/"}}" target="_blank" rel="noopener noreferrer">
                            <img src="/public/images/home/door-ccsn-logo.png" alt="Creative Community Service Network logo" loading="lazy">
                            <span class="facade-door-handle" aria-hidden="true"></span>
                            <img
                                class="facade-volunteer-sign"
                                src="/public/images/home/volunteer-sign.png"
                                alt="Volunteer sign"
                                loading="lazy"
                            >
                        </a>
                    </article>

                    <article class="facade-store facade-store-window">
                        <div class="facade-awning facade-awning-large" aria-hidden="true"></div>
                        <a class="facade-window" href="{{defaultUrl home.lowerFrisbeeLinkUrl "/events"}}">
                            <img src="/public/images/home/door-frisbee-logo.png" alt="RIC3 Fam Frisbee logo" loading="lazy">
                        </a>
                    </article>

                    <div class="facade-people" aria-label="Family silhouettes in front of the storefront" role="img">
                        <img class="facade-person facade-person-girl" src="/public/images/home/person-girl.png" alt="" loading="lazy">
                        <img class="facade-person facade-person-man" src="/public/images/home/person-man.png" alt="" loading="lazy">
                        <img class="facade-person facade-person-boy" src="/public/images/home/person-boy.png" alt="" loading="lazy">
                    </div>
                </section>

                <a class="facade-side-logo" href="https://bit.ly/RICthree" aria-label="RIC3 Fam">
                    <img src="/public/images/home/ric3-fam-logo.png" alt="RIC3 Fam logo" loading="lazy">
                </a>

                <div class="facade-ground" aria-hidden="true"></div>
            </section>
        </div>
    </section>

    <script src="/public/js/homeBuilding.js"></script>
</main>
