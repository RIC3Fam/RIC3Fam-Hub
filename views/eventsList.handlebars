<!-- Events List -->
<div class="events-page">
    <div class="events-page-header">
        <img
            class="events-page-logo"
            src="/public/images/ric3-fam-logo.jpg"
            alt="RIC3 Fam"
        >
        <h1 class="events-page-title">EVENTS</h1>
    </div>

    <div class="list-wrapper">
        {{#if currentUser.isAdmin}}
            <a href="/create-event">Create New Event</a>
        {{/if}}
        <h3 class="list-header">UPCOMING EVENTS</h3>
        <dl id="game-list" class="list-of-all">
            {{#each events}}
                <dd class="search-result">
                    <a href="/events/{{this._id}}">{{this.gameName}}</a>
                    {{#ifEquals this.visibility "private"}}
                        <span class="visibility-badge">Private</span>
                    {{else}}
                        <span class="visibility-badge">Public</span>
                    {{/ifEquals}}
                </dd>
            {{/each}}
        </dl>
    </div>

    {{#if currentUser.isAdmin}}
        {{> addToSlideshow route='events' isEventPage=true}}
    {{/if}}

    {{> partials/pictureSlider}}

    <div class="list-wrapper past-events-section">
        <h3 class="list-header">PAST EVENTS</h3>
        <dl id="past-game-list" class="list-of-all">
            {{#each pastEvents}}
                <dd class="search-result">
                    <a href="/events/{{this._id}}">{{this.gameName}}</a>
                    {{#ifEquals this.visibility "private"}}
                        <span class="visibility-badge">Private</span>
                    {{else}}
                        <span class="visibility-badge">Public</span>
                    {{/ifEquals}}
                </dd>
            {{else}}
                <dd class="muted">No past events yet.</dd>
            {{/each}}
        </dl>
    </div>
</div>
